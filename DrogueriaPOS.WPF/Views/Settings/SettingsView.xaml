<UserControl x:Class="DrogueriaPOS.WPF.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Encabezado -->
                <RowDefinition Height="Auto"/> <!-- Datos de la tienda -->
                <RowDefinition Height="Auto"/> <!-- Caja -->
                <RowDefinition Height="Auto"/> <!-- Impresión -->
                <RowDefinition Height="Auto"/> <!-- Botón guardar -->
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- ENCABEZADO                                   -->
            <!-- ============================================ -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="20"
                    Margin="0,0,0,15"
                    CornerRadius="8">
                <TextBlock Text="Configuración del Sistema"
                           Style="{StaticResource TitleTextStyle}"/>
            </Border>

            <!-- ============================================ -->
            <!-- SECCIÓN: DATOS DE LA TIENDA                 -->
            <!-- ============================================ -->
            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="20"
                    Margin="0,0,0,15"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="🏪 Datos de la Tienda"
                               Style="{StaticResource SubtitleTextStyle}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nombre de la tienda -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Nombre de la tienda"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- NIT -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="NIT"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StoreNIT, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- Dirección -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Dirección"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- Teléfono -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="Teléfono"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- SECCIÓN: CAJA                               -->
            <!-- ============================================ -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="20"
                    Margin="0,0,0,15"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="🏧 Configuración de Caja"
                               Style="{StaticResource SubtitleTextStyle}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nombre del cajero -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre del cajero"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CashierName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- Número de caja -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Número de caja"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CashRegisterNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10"
                                     FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- SECCIÓN: IMPRESIÓN                          -->
            <!-- ============================================ -->
            <Border Grid.Row="3"
        Background="{StaticResource SurfaceBrush}"
        Padding="20"
        Margin="0,0,0,15"
        CornerRadius="8">
                <Border.Resources>
                    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                </Border.Resources>

                <StackPanel>
                    <TextBlock Text="🖨️ Configuración de Impresión"
                   Style="{StaticResource SubtitleTextStyle}"
                   Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Tipo + AutoPrint -->
                            <RowDefinition Height="Auto"/>
                            <!-- Campo condicional -->
                            <RowDefinition Height="Auto"/>
                            <!-- Pie de factura -->
                        </Grid.RowDefinitions>

                        <!-- Tipo de conexión -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="Tipo de conexión"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding PrinterTypes}"
                          SelectedItem="{Binding PrinterType}"
                          Padding="10"
                          FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- Imprimir automáticamente -->
                        <StackPanel Grid.Row="0" Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding AutoPrint}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                            <TextBlock Text="Imprimir automáticamente al finalizar la venta"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Campo condicional: USB — nombre en "Dispositivos e impresoras" -->
                        <StackPanel Grid.Row="1" Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsUsbPrinter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nombre de la impresora (tal como aparece en Dispositivos e impresoras)"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>
                            <TextBox Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- Campo condicional: Serial — puerto COM -->
                        <StackPanel Grid.Row="1" Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsSerialPrinter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Puerto serial (ej: COM3)"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>
                            <TextBox Text="{Binding PrinterPort, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- Campo condicional: Network — dirección IP -->
                        <StackPanel Grid.Row="1" Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsNetworkPrinter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Dirección de red (ej: 192.168.1.100:9100)"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NetworkAddress, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         FontSize="{StaticResource FontSizeNormal}"/>
                        </StackPanel>

                        <!-- Mensaje pie de factura — siempre visible -->
                        <StackPanel Grid.Row="2" Grid.Column="0"
                        Grid.ColumnSpan="3">
                            <TextBlock Text="Mensaje pie de factura"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ReceiptFooterMessage, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         FontSize="{StaticResource FontSizeNormal}"
                         MaxLength="200"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- BOTÓN GUARDAR                               -->
            <!-- ============================================ -->
            <Border Grid.Row="4"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="20"
                    CornerRadius="8">
                <Button Content="💾 Guardar Configuración"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Padding="20,10"
                        Command="{Binding SaveCommand}"/>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
