<UserControl x:Class="DrogueriaPOS.WPF.Views.Products.ProductFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DrogueriaPOS.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Encabezado -->
                    <RowDefinition Height="*"/>
                    <!-- Formulario -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                </Grid.RowDefinitions>

                <!-- ============================================ -->
                <!-- ENCABEZADO                                   -->
                <!-- ============================================ -->
                <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="20"
                    Margin="0,0,0,20"
                    CornerRadius="8">
                    <TextBlock Text="{Binding Title}"
                          Style="{StaticResource TitleTextStyle}"/>
                </Border>

                <!-- ============================================ -->
                <!-- FORMULARIO                                   -->
                <!-- ============================================ -->
                <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="30"
                    CornerRadius="8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========== COLUMNA IZQUIERDA ========== -->
                        <StackPanel Grid.Column="0">

                            <!-- Código de Barras -->
                            <TextBlock Text="Código de Barras *"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Nombre Comercial -->
                            <TextBlock Text="Nombre Comercial *"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Nombre Genérico -->
                            <TextBlock Text="Nombre Genérico"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GenericName, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Concentración -->
                            <TextBlock Text="Concentración"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Concentration, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Presentación -->
                            <TextBlock Text="Presentación"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Presentation, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>
                        </StackPanel>

                        <!-- ========== COLUMNA DERECHA ========== -->
                        <StackPanel Grid.Column="2">

                            <!-- Registro INVIMA -->
                            <TextBlock Text="Registro INVIMA"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding InvimaRegistration, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Precio de Venta -->
                            <TextBlock Text="Stock"
                                Style="{StaticResource BodyTextStyle}"
                                Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Precio de Venta -->
                            <TextBlock Text="Precio de Venta *"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Porcentaje IVA -->
                            <TextBlock Text="Porcentaje IVA (%)"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding IvaPercentage, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Margin="0,0,0,15"/>

                            <!-- Descripción -->
                            <TextBlock Text="Descripción"
                                  Style="{StaticResource BodyTextStyle}"
                                  Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Padding="10"
                                FontSize="{StaticResource FontSizeNormal}"
                                Height="50"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,15"/>

                            <!-- Activo (solo en modo edición) -->
                            <CheckBox Content="Producto activo"
                                 IsChecked="{Binding IsActive}"
                                 Margin="0,10,0,0">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- BOTONES                                      -->
                <!-- ============================================ -->
                <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       Margin="0,20,0,0">

                    <Button Content="Cancelar"
                       Style="{StaticResource SecondaryButton}"
                       Width="120"
                       Margin="0,0,10,0"
                       Command="{Binding CancelCommand}"/>

                    <Button Content="Guardar"
                       Style="{StaticResource PrimaryButton}"
                       Width="120"
                       Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <controls:BusyOverlay IsBusy="{Binding IsBusy}"
                               BusyMessage="{Binding BusyMessage}"/>
    </Grid>
</UserControl>
    