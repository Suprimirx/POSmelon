<UserControl x:Class="DrogueriaPOS.WPF.Views.CashRegister.OpenSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="*"/>
            <!-- Contenido centrado -->
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                Padding="20,15"
                Margin="0,0,0,20"
                CornerRadius="8">
            <TextBlock Text="🏧 Abrir Caja"
                       Style="{StaticResource TitleTextStyle}"/>
        </Border>

        <!-- Contenido centrado -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420">
            <StackPanel>

                <!-- Tarjeta: información de configuración -->
                <Border Background="{StaticResource SurfaceBrush}"
                        Padding="25"
                        CornerRadius="8"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Información de Caja"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   Margin="0,0,0,20"/>

                        <!-- Cajero -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="👤 Cajero:"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CashierName}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Número de caja -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="🏧 Caja N°:"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CashRegisterNumber}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advertencia si configuración incompleta -->
                <Border Background="{StaticResource WarningBrush}"
                        Padding="15,12"
                        CornerRadius="8"
                        Margin="0,0,0,15">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CashierName}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CashierName}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="⚠️ El nombre del cajero o el número de caja no están configurados. Ve a Configuración antes de continuar."
                               Foreground="White"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Tarjeta: monto inicial -->
                <Border Background="{StaticResource SurfaceBrush}"
                        Padding="25"
                        CornerRadius="8"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Monto Inicial"
                                   Style="{StaticResource SubtitleTextStyle}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Ingrese el efectivo con el que inicia la caja"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,0,0,20"/>

                        <TextBox Text="{Binding InitialCashAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 Padding="12,14"
                                 FontSize="{StaticResource FontSizeLarge}"
                                 FontWeight="SemiBold"
                                 TextAlignment="Right"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <!-- Botón abrir -->
                <Button Content="✅ Abrir Caja"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Padding="16,14"
                        FontSize="{StaticResource FontSizeMedium}"
                        Command="{Binding OpenSessionCommand}"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
